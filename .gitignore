# Rust build artifacts — this is the big one. Never commit target/.
/target/
**/*.rs.bk

# Packaged app bundles produced by scripts/build-app.sh.
# Distribute these via GitHub Releases, not git.
/dist/

# Python tooling (scripts under tools/)
__pycache__/
*.py[cod]
*.pyo

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Local runtime data (SQLite, logs) if any ever lands in-repo
*.db
*.db-journal
*.log
