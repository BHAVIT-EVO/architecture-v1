# Rust build artifacts — this is the big one. Never commit target/.
/target/
**/*.rs.bk

# Packaged app bundles produced by scripts/build-app.sh.
# Distribute these via GitHub Releases, not git.
/dist/

# Python tooling (scripts under tools/)
__pycache__/
*.py[cod]
*.pyo

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Secrets — never commit real credentials
.env
.env.*
!.env.example

# Local runtime data (SQLite, logs) if any ever lands in-repo
*.db
*.db-journal
*.log

# Archived dead code / stale docs / old pitch material (never part of the build)
/attic/

# Mission transcripts and backups of paths: never shipped, never committed.
/docs/mission/evidence/

# Local ONNX Runtime provisioning (docs/RELEASE-CHECKLIST.md §1.2).
/vendor/ort/

# Generated code graph (graphify output) — regenerable, not source.
/graphify-out/

# Reverse-engineering research dumps and design sketches. Local reference
# material: large, third-party artefacts, never part of the build.
/RE done/
/notch idea/

# Stray images pasted at the repository root. No code references them.
/assets/

# A screenshot of this machine's desktop, taken for a session.
/screenshot.png

# Local staging copies and scratch directories.
/backups/
/staging-new-app/
/staging-voice-test/
/.tmp-shot/
