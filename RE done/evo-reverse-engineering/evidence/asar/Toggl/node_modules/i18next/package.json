{
  "name": "i18next",
  "version": "26.4.2",
  "description": "i18next internationalization framework",
  "main": "./dist/cjs/i18next.js",
  "module": "./dist/esm/i18next.js",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./dist/esm/i18next.js"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./dist/cjs/i18next.js"
      }
    }
  },
  "homepage": "https://www.i18next.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/i18next/i18next.git"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://www.locize.com/i18next"
    },
    {
      "type": "individual",
      "url": "https://www.i18next.com/how-to/faq#i18next-is-awesome.-how-can-i-support-the-project"
    },
    {
      "type": "individual",
      "url": "https://www.locize.com"
    }
  ],
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arktype/attest": "^0.56.3",
    "@babel/core": "^7.29.0",
    "@babel/plugin-transform-async-generator-functions": "^7.29.0",
    "@babel/plugin-transform-modules-commonjs": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.29.0",
    "@babel/register": "^7.29.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "4.1.11",
    "babelify": "^10.0.0",
    "cpy-cli": "^7.0.0",
    "eslint": "9.39.4",
    "gh-release": "^8.1.0",
    "husky": "^9.1.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-backend": "^4.0.1",
