    "i18next-sprintf-postprocessor": "^0.2.2",
    "lint-staged": "^17.3.0",
    "neostandard": "^0.13.0",
    "nise": "6.1.5",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.62.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "4.1.11"
  },
  "author": "Jan Mühlemann <jan.muehlemann@gmail.com> (https://github.com/jamuhl)",
  "license": "MIT",
